# --- Database ---
# If ../.env.local exists (written by `neon deploy`), its values override these.
DATABASE_URL="postgresql://bookleaf:bookleaf@localhost:5432/bookleaf?schema=public"
# Direct (non-pooled) connection for migrations. Same as DATABASE_URL for local Docker Postgres.
DATABASE_URL_UNPOOLED="postgresql://bookleaf:bookleaf@localhost:5432/bookleaf?schema=public"

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- AI (server-side only; never exposed to the browser) ---
# Leave the key empty to run with AI disabled: tickets still work, rule-based
# classification and template drafts are used instead.
# Provider: "gemini" (default) or "anthropic".
AI_PROVIDER="gemini"
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Only needed when AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Optional model override. Empty = provider default (gemini-3.8-flash / claude-haiku-5-5)
AI_MODEL=""
AI_TIMEOUT_MS=20000

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed for CORS in development (Vite dev server)
CORS_ORIGINS="http://localhost:5173"
