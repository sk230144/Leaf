# --- Database ---
DATABASE_URL="postgresql://bookleaf:bookleaf@localhost:5432/bookleaf?schema=public"

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- AI (server-side only; never exposed to the browser) ---
# Leave empty to run with AI disabled: tickets still work, rule-based
# classification and template drafts are used instead.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-haiku-5-5"
AI_TIMEOUT_MS=20000

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed for CORS in development (Vite dev server)
CORS_ORIGINS="http://localhost:5173"
