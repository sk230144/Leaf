{
  "name": "@bookleaf/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/src/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=../.env.local src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "start:prod": "prisma migrate deploy && node dist/prisma/seed.js --if-empty && node dist/src/index.js",
    "db:migrate": "dotenv -e ../.env.local -e .env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../.env.local -e .env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../.env.local -e .env -- tsx prisma/seed.ts",
    "db:reset": "dotenv -e ../.env.local -e .env -- prisma migrate reset --force",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@vercel/functions": "^3.10.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv-cli": "^11.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
